# Заявки в Telegram: токен бота от @BotFather и ID чата, куда присылать заявки.
# Задаются в настройках приложения на хостинге (переменные окружения), в репозиторий не попадают.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Запасной вариант: адрес CRM или вебхука, куда сервер пересылает заявки (POST JSON).
# Пока ничего не задано, форма честно показывает ошибку отправки.
CRM_WEBHOOK_URL=
